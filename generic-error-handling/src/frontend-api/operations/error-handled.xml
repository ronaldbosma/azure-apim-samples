<policies>
    <inbound>
        <base />
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <!-- All errors are marked as handled, which means the global error handling is skipped and they are returned as is -->
        <set-variable name="error-handled" value="@(true)" />
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>