<policies>
    <inbound>
        <base />
        
        <rate-limit calls="5" renewal-period="30" 
                    retry-after-header-name="Retry-After-On-Operation"
                    remaining-calls-header-name="Remaining-Calls-On-Operation" 
                    total-calls-header-name="Total-Calls-On-Operation" />

        <return-response>
            <set-status code="200" />
        </return-response>
    </inbound>
    
    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>