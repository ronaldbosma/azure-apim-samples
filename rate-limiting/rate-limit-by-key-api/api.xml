<policies>
    <inbound>
        <base />
        
        <rate-limit-by-key calls="10" renewal-period="30" 
                           counter-key="@(context.Api.Id)" 
                           retry-after-header-name="Retry-After-On-API" 
                           remaining-calls-header-name="Remaining-Calls-On-API" 
                           total-calls-header-name="Total-Calls-On-API"/>
    </inbound>
    
    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>