<policies>
    <inbound>
        <base />
        
        <!-- 
            Use combination of API ID and Operation ID as the counter key. 
            If we only use the Operation ID, the rate limit would be shared across all APIs that use rate-limit-by-key and have an operation with the same ID.
        -->
        <rate-limit-by-key calls="5" renewal-period="30" counter-key="@($"{context.Api.Id};{context.Operation.Id}")" 
                           retry-after-header-name="Retry-After-On-Operation" 
                           remaining-calls-header-name="Remaining-Calls-On-Operation" 
                           total-calls-header-name="Total-Calls-On-Operation"/>

        <return-response>
            <set-status code="200" />
        </return-response>
    </inbound>
    
    <backend>
        <base />
    </backend>

    <outbound>
        <base />
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>