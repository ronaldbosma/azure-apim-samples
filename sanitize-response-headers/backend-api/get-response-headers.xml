<policies>
    <inbound>
        <base />
        <validate-parameters specified-parameter-action="ignore" unspecified-parameter-action="ignore">
            <query specified-parameter-action="prevent" unspecified-parameter-action="prevent" />
        </validate-parameters>
    </inbound>

    <backend>
        <!-- The base policy has been removed because we're not calling any backend. -->
    </backend>

    <outbound>
        <base />
        <set-status code="200" />

        <!--
            Add safe headers based on the numberOfSafeHeadersToReturn query parameter.
        -->
        
        <set-variable name="indexOfSafeHeadersToAdd" value="@(1)" />
        <set-variable name="numberOfSafeHeadersToReturn" value="@(int.Parse(context.Request.Url.Query.GetValueOrDefault("numberOfSafeHeadersToReturn", "0")))" />

        <choose>
            <!-- The logic in a retry policy always executes at least once. This check prevent a header from being returns when numberOfSafeHeadersToReturn is 0. -->
            <when condition="@((int)context.Variables["numberOfSafeHeadersToReturn"] > 0)">

                <!-- The retry policy is used as for-loop workaround. By using nested retries we bypasses the 50-count limit of the retry policy. -->
                <retry condition="@((int)context.Variables["indexOfSafeHeadersToAdd"] <= (int)context.Variables["numberOfSafeHeadersToReturn"])" count="50" interval="0">
                    <retry condition="@((int)context.Variables["indexOfSafeHeadersToAdd"] <= (int)context.Variables["numberOfSafeHeadersToReturn"])" count="50" interval="0">
                        <set-header name="@($"Safe-Header-{context.Variables["indexOfSafeHeadersToAdd"]}")" exists-action="override">
                            <value>@($"Safe-Header-{context.Variables["indexOfSafeHeadersToAdd"]}")</value>
                        </set-header>
                        <set-variable name="indexOfSafeHeadersToAdd" value="@( (int)context.Variables["indexOfSafeHeadersToAdd"] + 1 )" />
                    </retry>
                </retry>
            </when>
        </choose>
        

        <!--
            Add unsafe headers based on the numberOfUnsafeHeadersToReturn query parameter.
        -->
        
        <set-variable name="indexOfUnsafeHeadersToAdd" value="@(1)" />
        <set-variable name="numberOfUnsafeHeadersToReturn" value="@(int.Parse(context.Request.Url.Query.GetValueOrDefault("numberOfUnsafeHeadersToReturn", "0")))" />

        <choose>
            <!-- The logic in a retry policy always executes at least once. This check prevent a header from being returns when numberOfUnsafeHeadersToReturn is 0. -->
            <when condition="@((int)context.Variables["numberOfUnsafeHeadersToReturn"] > 0)">
                
                <!-- The retry policy is used as for-loop workaround. By using nested retries we bypasses the 50-count limit of the retry policy. -->
                <retry condition="@((int)context.Variables["indexOfUnsafeHeadersToAdd"] <= (int)context.Variables["numberOfUnsafeHeadersToReturn"])" count="50" interval="0">
                    <retry condition="@((int)context.Variables["indexOfUnsafeHeadersToAdd"] <= (int)context.Variables["numberOfUnsafeHeadersToReturn"])" count="50" interval="0">
                        <set-header name="@($"Unsafe-Header-{context.Variables["indexOfUnsafeHeadersToAdd"]}")" exists-action="override">
                            <value>@($"Unsafe-Header-{context.Variables["indexOfUnsafeHeadersToAdd"]}")</value>
                        </set-header>
                        <set-variable name="indexOfUnsafeHeadersToAdd" value="@( (int)context.Variables["indexOfUnsafeHeadersToAdd"] + 1 )" />
                    </retry>
                </retry>
            </when>
        </choose>
    </outbound>

    <on-error>
        <base />
    </on-error>
</policies>